      "name": "HTTP Request",
      "alwaysOutputData": true,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "\nconst services = $input.all()\n  .map(item => item.json)\n  .filter(service =>\n    service.id != null &&\n    typeof service.name === 'string' &&\n    service.active === true\n  );\n\nconst trigger = $('Telegram Trigger').first().json;\n\nconst chatId = trigger.message?.chat?.id;\n\nif (!chatId) {\n  throw new Error('Не удалось определить chatId');\n}\n\nconst keyboard = services.map(service => [\n  {\n    text: service.name,\n    callback_data: `service:${service.id}`\n  }\n]);\n\nreturn [{\n  json: {\n    chatId,\n    text: services.length > 0\n      ? 'Выберите интересующую услугу:'\n      : 'Сейчас нет доступных услуг.',\n    replyMarkup: services.length > 0\n      ? { inline_keyboard: keyboard }\n      : null\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        -96
      ],
      "id": "70957151-b145-4dab-957a-72425c65398d",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/botYOUR_TOKEN/sendMessage",
        "sendBody": true,
        "specifyBody": "=json",
        "bodyParameters": {
          "parameters": [
            {}
          ]
        },
        "jsonBody": "=\n{{ JSON.stringify({\n  chat_id: $json.chatId,\n  text: $json.text,\n  ...($json.replyMarkup\n    ? { reply_markup: $json.replyMarkup }\n    : {})\n}) }}\n",
        "options": {}
      },
