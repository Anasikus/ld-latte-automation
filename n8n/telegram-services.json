      "id": "71aeb28b-f552-44e8-ad6a-f79e2b6821cf",
      "name": "Get Selected Service",
      "alwaysOutputData": true,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "\nconst callback = $('Telegram Trigger').first().json.callback_query;\n\nconst service = $input.all()\n  .map(item => item.json)\n  .find(item =>\n    item.id != null &&\n    typeof item.name === 'string'\n  );\n\nlet text;\n\nif (service) {\n  text = `Вы выбрали услугу: ${service.name}`;\n} else {\n  text = 'Эта услуга больше недоступна. Отправьте /start для обновления списка.';\n}\n\n// Ограничение Telegram для текста callback-уведомления\nif (text.length > 200) {\n  text = text.slice(0, 197) + '...';\n}\n\nreturn [{\n  json: {\n    callbackId: callback.id,\n    text\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
