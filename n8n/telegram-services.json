    {
      "parameters": {
        "jsCode": "const trigger = $('Telegram Trigger').first().json;\n\nconst chatId = trigger.message?.chat?.id;\n\nif (!chatId) {\n  throw new Error('Не удалось определить chatId');\n}\n\nreturn [{\n  json: {\n    chatId,\n    text: 'Не удалось загрузить список услуг. Попробуйте отправить /start немного позже.',\n    replyMarkup: null\n  }\n}];"
      },
